# Proposed settings. Application configuration is implemented during P01/P02.
# Copy to .env locally. Never commit credentials or paste them into chat.
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
# lon_min,lat_min,lon_max,lat_max; final pilot bounds are selected after coverage review.
FIRMS_BBOX=
DATABASE_URL=
OBJECT_STORE_LOCAL_PATH=./local/objects
APP_DATA_MODE=HISTORICAL_REPLAY
# Earthdata authentication is configured through the selected official client.
# Do not add an Earthdata password here or in frontend variables.
